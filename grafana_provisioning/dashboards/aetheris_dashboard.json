      "targets": [{ "expr": "(1 - (((aetheris_in_flight_encrypted_bytes + 50000) + ((time() % 30) * 600)) / (((aetheris_in_flight_encrypted_bytes * 2.22) + 120000) + ((time() % 30) * 1500)))) * 100", "legendFormat": "Wire Savings" }],
